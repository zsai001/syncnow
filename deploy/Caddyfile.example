# Caddyfile for SyncNow Self-Hosted Relay (Automatic HTTPS + WebSocket WSS)
# Docker Compose defaults to upstream "syncnow-relay:8787".
# On a bare-metal VPS, set RELAY_UPSTREAM=127.0.0.1:8787 (or edit the address directly).
{$RELAY_DOMAIN:relay.example.com} {
    encode zstd gzip

    request_body {
        max_size 64MB
    }

    # Reverse proxy HTTP, streaming /v1/tmp/* chunks, and WebSockets (/ws, /v1/signal/ws, /v1/tunnel/ws)
    reverse_proxy {$RELAY_UPSTREAM:syncnow-relay:8787} {
        flush_interval -1
    }
}
