# SyncNow Self-Hosted Relay Configuration
# Copy to .env (Docker) or /etc/syncnow-relay.env (VPS systemd)

# Host port exposed by Docker Compose (default: 8787)
SYNCNOW_PORT=8787

# Listen address inside service
SYNCNOW_RELAY_ADDR=:8787

# Unified xtags.top identity verification endpoint (default: https://api.xtags.top)
# Set to empty string ("") ONLY for airgapped static-token mode.
SYNCNOW_AUTH_API=https://api.xtags.top

# Optional: Comma-separated xtags user IDs allowed to use this relay (recommended for private self-hosting!)
# Find your user ID inside SyncNow -> Account & Cloud Relay -> ID: usr_...
SYNCNOW_ALLOW_USERS=

# Optional: Static bearer token for offline/airgapped setups without xtags.top
SYNCNOW_RELAY_TOKEN=

# Optional: Admin token for publishing app updates via POST /v1/admin/updates
SYNCNOW_ADMIN_TOKEN=

# Retention & quota tuning (all editable live on the /setup Web Console)
SYNCNOW_MAX_ENVELOPES=500
SYNCNOW_MAX_BLOB_MB=25
SYNCNOW_BLOB_TTL_DAYS=7

# Tmp Large File Relay defaults (chunked E2EE streaming)
SYNCNOW_MAX_TMP_FILE_MB=1024
SYNCNOW_MAX_TMP_TOTAL_MB=8192
SYNCNOW_TMP_TTL_HOURS=12
SYNCNOW_TMP_ACK_GRACE_MINUTES=30

# Optional domain for automatic Let's Encrypt HTTPS/WSS with `docker compose --profile tls up -d`
RELAY_DOMAIN=relay.example.com
